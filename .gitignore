# Flutter / Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock

# Generated code (regenerate with: dart run build_runner build)
*.g.dart
*.freezed.dart
*.mocks.dart

# Platform folders are generated by tool/setup.ps1 (flutter create).
# They contain no NoteNest source, so they stay out of the repository.
/android/
/ios/
/linux/
/macos/
/windows/
/web/

# IDE
.idea/
.vscode/
*.iml
*.iws

# OS
.DS_Store
Thumbs.db

# Local artefacts
*.log
/coverage/

# Release artefacts (produced by tool/windows_installer.iss and flutter build)
/dist/
/tool/dist/
*.exe
*.apk
*.aab
!assets/**/*.ico

# Signing material must never be committed
*.jks
*.keystore
*.keystore.properties
key.properties
android/app/upload-keystore.*

# Flutter tooling leftovers
.flutter/
coverage/
*.tmp
